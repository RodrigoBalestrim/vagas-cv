rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuário só pode ler/escrever o PRÓPRIO documento de perfil.
    // Autenticado obrigatório: usuário anônimo/deslogado não acessa nada.
    match /perfis/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Coleção pública de vagas (só leitura para qualquer pessoa).
    match /vagas/{vagaId} {
      allow read: if true;
      allow write: if false;
    }

    // Qualquer outra coleção: negado por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}